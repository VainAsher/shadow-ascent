                "id": "sophia_letter_archive_item",
                "item_key": "letter_from_sophia"
              }
            }
          ],
          "story_beat": "Sophia chose survival, not abandonment.",
          "sets_flags": [
            "sophia_q2_complete"
          ]
        },
        {
          "id": "sophia_q3_map_to_skyroad",
          "act": "ACT_3_TO_ACT_4",
          "plateau": "EMBER_MONASTERY",
          "required_flags": [
