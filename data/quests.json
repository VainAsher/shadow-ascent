  "chains": [
    {
      "id": "quest_samson_spear_at_your_back",
      "npc": "SAMSON",
      "title": "The Spear at Your Back",
      "steps": [
        {
          "id": "samson_q1_unfinished_sparring_match",
          "act": "ACT_0",
          "plateau": "LANTERN_HEIGHTS",
          "hook": "Samson challenges Aen to a friendly duel.",
          "objective": "Enter a small dojo room and defeat Samson's training ghost in a timed combat challenge.",
          "area_pool": [
            "area_training_dojo",
            "elastic_lh_training_loop"
          ],
          "reward": "small_permanent_hp_or_poise_buff",
          "reward_effects": [
            {
              "type": "PASSIVE_BUFF",
              "magnitude": 1,
              "payload": {
                "id": "samson_q1_duelist_resolve_buff",
                "buff_family": "hp_or_poise"
              }
            }
          ],
          "story_beat": "Samson believes in Aen without flattery.",
          "sets_flags": [
            "samson_q1_complete"
          ]
        },
        {
          "id": "samson_q2_echoes_in_the_dark",
          "act": "ACT_2",
          "plateau": "HOLLOW_DEPTHS",
          "required_flags": [
            "weightbound_ogre_defeated"
          ],
          "hook": "Aen hears Samson's echo more clearly.",
          "objective": "Follow echo waypoints through optional rooms and defeat a Guilt Wraith.",
          "area_pool": [
            "area_echo_galleries",
            "elastic_hd_samson_echo"
          ],
          "enemy": "GUILT_WRAITH",
          "wraith_dialogue": [
            "You abandoned me.",
            "You chose her over us."
          ],
          "reward": "samson_charm_low_health_bonus",
          "reward_effects": [
            {
              "type": "CHARM_UNLOCK",
              "magnitude": 1,
              "payload": {
                "id": "samson_brother_echo_charm",
                "charm_key": "samson_low_health_bonus"
              }
            }
          ],
          "story_beat": "Aen acknowledges the drift; memory becomes strength, not shame.",
          "sets_flags": [
            "samson_q2_complete"
          ]
        },
        {
          "id": "samson_q3_brother_returns",
          "act": "ACT_3",
          "plateau": "EMBER_MONASTERY",
          "required_flags": [
            "hearth_joined"
          ],
          "hook": "Full reunion cutscene.",
          "objective": "Optional AI co-op trial — Samson fights beside you.",
          "area_pool": [
            "area_ember_monastery_hub",
            "elastic_em_samson_ai_trial"
          ],
          "reward": "samson_at_your_back_group_combat_bonus",
          "reward_effects": [
            {
              "type": "PASSIVE_BUFF",
              "magnitude": 1,
              "payload": {
                "id": "samson_group_combat_aura",
                "buff_family": "group_combat_bonus"
              }
            }
          ],
          "sets_flags": [
            "samson_returned",
            "samson_q3_complete"
          ]
        }
      ]
    },
    {
