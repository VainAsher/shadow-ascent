# Normalize line endings on checkout
* text=auto

# Shell scripts must be LF on all platforms (CRLF breaks bash on Linux)
gradlew       text eol=lf
*.sh          text eol=lf

# Windows scripts stay CRLF
gradlew.bat   text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Data and source files — normalize to LF
*.java        text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.properties  text eol=lf

# Binaries — no line-ending conversion
*.jar         binary
*.png         binary
*.jpg         binary
*.gif         binary
